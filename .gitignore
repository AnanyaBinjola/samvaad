# ==============================================================================
# Samvaad - Git Ignore Rules
# ==============================================================================

# Environment Variables & Secrets (NEVER commit secrets or API keys)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Node.js & Frontend Build Outputs
node_modules/
dist/
dist-ssr/
build/
.npm
.eslintcache

# Python Virtual Environments & Packages
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.ruff_cache/

# Logs & Debug Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating System & IDE Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# Generated / Transient Audio Output Files (Keep test fixtures speech_en.wav and test_sample.wav tracked)
decoded_*.wav
e2e_*.wav
prompt9_*.wav
translated_*.wav
output_*.wav
temp_*.wav
*.mp3
