# ==============================================================================
# Samvaad - Standalone Multilingual Speech Translation Environment Configuration
# ==============================================================================

# Google AI Studio API Key (Required for real Gemma model inference)
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=

# Supported Gemma Model for Multilingual Translation:
# Options: gemma-4-26b-a4b-it (recommended MoE), gemma-4-31b-it, gemma-2-9b-it, gemma-2-27b-it
GEMMA_MODEL_ID=gemma-4-26b-a4b-it

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Optional Frontend Environment Variables (passed to Vite during build/dev)
VITE_SAMVAAD_API_URL=/api/translate
